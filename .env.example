APP_NAME=GEC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Douala

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Chiffrement des fichiers (AES-256) — créer avec `php artisan gec:cle-fichiers`.
# Conserver une copie de cette clé EN LIEU SÛR, hors du serveur : sans elle,
# documents et sauvegardes sont définitivement illisibles.
GEC_FICHIERS_CLE=
GEC_FICHIERS_CLE_ID=1
GEC_FICHIERS_CLES_PRECEDENTES=

# Dossier de données du stockage (MinIO sur ce serveur) : affiche l'espace
# libre du disque dans Sécurité & Audit › Stockage. Vide pour un stockage cloud.
STOCKAGE_CHEMIN_DISQUE=

VITE_APP_NAME="${APP_NAME}"

# Copie de secours sur le PC, rangée par dossier (ZIP chiffrés, voir App\Services\SauvegardeLocale).
# Désactivée tant que le mot de passe est vide. Gardez aussi ce mot de passe HORS de ce PC.
GEC_SAUVEGARDE_DOSSIER=C:/GEC-Sauvegarde
GEC_SAUVEGARDE_MOT_DE_PASSE=
# Outil qpdf : copies personnelles en PDF qui s'ouvrent avec le mot de passe de la personne OU le passe-partout.
GEC_QPDF_BINAIRE=qpdf
